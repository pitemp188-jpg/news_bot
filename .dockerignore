# 模块: .dockerignore
# 职责: 缩小 docker 构建上下文——排除虚拟环境、运行时数据、前端依赖与缓存
# 来源: 自研

# 运行时数据与密钥绝不进镜像
.env
data/
*.db
*.db-wal
*.db-shm

# Python
.venv/
__pycache__/
*.pyc
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# 前端：依赖与产物在镜像内重新装/重新构建
web/node_modules/
web/dist/

# 仓库与编辑器元数据
.git/
.gitignore
.gitattributes
.github/
.editorconfig
.vscode/
docs/
tests/
