# 复制为 .env 后填写真实值；.env 不入库
# ---- 大模型（OpenAI 兼容接口）----
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ---- 搜索（自建 SearXNG 或 Tavily）----
SEARCH_PROVIDER=searxng
SEARXNG_URL=http://127.0.0.1:8080
TAVILY_API_KEY=

# ---- 微信（腾讯 iLink Bot 通道）----
# 执行 `python -m newsbot login weixin` 扫码后凭证写入 data/weixin/，一般无需手填
WEIXIN_TOKEN=
WEIXIN_ACCOUNT_ID=
WEIXIN_ALLOWED_USERS=

# ---- QQ 开放平台 ----
QQ_APP_ID=
QQ_CLIENT_SECRET=
QQ_ALLOWED_USERS=

# ---- 管理后台 ----
ADMIN_PASSWORD=
