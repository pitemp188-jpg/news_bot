# 复制为 .env 后填写真实值；.env 不入库
# ---- 大模型（OpenAI 兼容接口）----
# 任意 OpenAI 兼容服务均可。火山方舟「编码套餐」示例：
#   LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v1
#   LLM_MODEL=deepseek-v4-flash
# 注意 coding 端点只支持套餐内模型，且路径必须带 /v1；普通方舟模型用 https://ark.cn-beijing.volces.com/api/v3
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# 浏览器子 Agent 专用模型（可选）：它需要每步快速返回且 JSON 稳定，
# 常与撰写日报的模型不是同一个。留空表示沿用 LLM_MODEL。
LLM_MODEL_BROWSER=

# ---- 搜索（四选一：feeds / bing / searxng / tavily）----
# feeds  ：内置，订阅权威源 RSS 并按关键词过滤。零配置、有发布日期与真实文章地址，
#          适合"每日行业热点"这类场景；覆盖范围限于 config.yaml 里配置的源。
# bing   ：内置，抓 Bing 结果页解析。零配置、能查任意关键词，
#          但时效过滤无效、结果偏向常青/SEO 页面，质量不如 feeds。
# searxng：自建实例，质量最好但需要自己部署。
# tavily ：商业 API，最省心，需要密钥。
SEARCH_PROVIDER=feeds
SEARXNG_URL=http://127.0.0.1:8080
TAVILY_API_KEY=

# ---- 微信（腾讯 iLink Bot 通道）----
# 执行 `python -m newsbot login weixin` 扫码后凭证写入 data/weixin/，一般无需手填
WEIXIN_TOKEN=
WEIXIN_ACCOUNT_ID=
WEIXIN_ALLOWED_USERS=

# ---- QQ 开放平台 ----
QQ_APP_ID=
QQ_CLIENT_SECRET=
QQ_ALLOWED_USERS=

# ---- 管理后台 ----
ADMIN_PASSWORD=
